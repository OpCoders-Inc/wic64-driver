 108                   ; send wic64 tcp read command
 109                   ; ---------------------------------------------------------
 110                   ;
 111                   ;   Sends WC_TCP_READ with explicit byte count.
 112                   ;
 113                   ;   Parameters:
 114                   ;
 115                   ;       .X  count low
 116                   ;       .Y  count high
 117                   
 118                       wic64_do_tcp_read
 119                   
 120                           .block
 121                   
 122 d7ac 20 5a d7             jsr wic64_do_send_mode
 123                   
 124 d7af a9 52                lda #"r"                ; protocol
 125 d7b1 20 89 d7             jsr wic64_write_byte
 126 d7b4 a9 22                lda #WC_TCP_READ        ; command
 127 d7b6 20 89 d7             jsr wic64_write_byte
 128 d7b9 8a                   txa                     ; count low
 129 d7ba 20 89 d7             jsr wic64_write_byte
 130 d7bd 98                   tya                     ; count high
 131 d7be 20 89 d7             jsr wic64_write_byte
 132                   
 133 d7c1 60                   rts
 134                   
 135                           .bend
