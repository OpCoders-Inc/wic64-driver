  59                   classmethod .macro ;method_offset
  60                            jsr setclass_+stkt
  61                            ldy #\1
  62                            jsr getmethod_+stkt
  63                            .endm
  64                   
  65                   supermethod .macro ;method_offset
  66                            jsr setsuper_+stkt
  67                            ldy #\1
  68                            jsr getmethod_+stkt
  69                            .endm
