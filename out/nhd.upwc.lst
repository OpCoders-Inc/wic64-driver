   1                   ;----[ memory.s ]-----------------------
   2                   
   3                   ;Memory Mapping Routines
   4                   seeram   = $02a7
   5                   seeioker = $02ac
   6                   
   7                   ;Other bits can be used in the map for
   8                   ;taken to mean that the OS allocated
   9                   ;them, or that they are in the REU, etc.
  10                   
  11                   memmap   = $0800 ;$08a0 (pages $09->$a0)
  12                   
  13                   mapfree  = $00
  14                   mapsys   = $01  ;Allocated by the system
  15                   maputil  = $02  ;Allocated by the util
  16                   mapapp   = $ff  ;Allocated by the app
  17                   
  18                   ;This is used so we don't have to pass
  19                   ;the default memory pool into every call
  20                   
  21                   mempool  = $0380 ;Memory Pool Start Page
  22                   
  23                   ;Pages are allocated from the top down
  24                   
  25                   ;Page number of first page is configured
  26                   ;and stored at mappgfst. But mappglst is
  27                   ;static, it's always page #$09.
  28                   
  29                   mappgfst = $08a1 ;First Page (variable)
  30                   mappglst = $09   ;Last  Page (constant)
  31                   
  32                   ;Memory Display Mode
  33                   
  34                   memdisp  = $08cc ;0=Pages,1=Kilobytes
  35                   
  36                   ;Struct
  37                   mhfree   = 0 ;1 byte
  38                   mhlen    = 1 ;2 bytes
  39                   mhsize   = 3
  40                   ;Malloc Header
  41                   
  42                   ;For realloc
  43                   memsize  = $61 ;$62
  44                   
