 223 d807 a9 00            lda #$00
 224 d809 8d d2 d8         sta c1
 225 d80c a9 00            lda #$00 
 226 d80e 8d d3 d8         sta c2
 227                   
 228 d811 a9 10            lda #$10
 229 d813 2c 0d dd         bit $dd0d
 230 d816 d0 11            bne success
 231                   
 232 d818 a9 10            lda #$10
 233                   
 234                   wait 
 235                   
 236 d81a 2c 0d dd         bit $dd0d
 237 d81d d0 0a            bne success
 238                   
 239 d81f ce d3 d8         dec c2
 240 d822 d0 f6            bne wait
 241 d824 ce d2 d8         dec c1
 242 d827 d0 f1            bne wait
 243                   
 244                   success
 245                   
 246 d829 60               rts        
