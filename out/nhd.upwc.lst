 161 12af 68                   pla                             ; command
 162 12b0 20 64 12             jsr wic64_write_byte
 163 12b3 ad f3 13             lda wic64_payload_size          ; payload low
 164 12b6 20 64 12             jsr wic64_write_byte
 165 12b9 ad f4 13             lda wic64_payload_size + 1      ; payload high
 166 12bc 20 64 12             jsr wic64_write_byte
