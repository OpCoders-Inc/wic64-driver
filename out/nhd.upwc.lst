   1                   ;----[ pointer.s ]----------------------
   2                   
   3                   rdxy     .macro ;Reads Ptr into X/Y
   4                            ldx \1
   5                            ldy \1+1
   6                            .endm
   7                   
   8                   ldxy     .macro ;Loads X/Y with address
   9                            ldx #<\1
  10                            ldy #>\1
  11                            .endm
  12                   
  13                   stxy     .macro
  14                            stx \1
  15                            sty \1+1
  16                            .endm
  17                   
  18                   ;---------------------------------------
  19                   ;Get and Set RegPtr from Store
  20                   
  21                   storeset .macro ;store,index
  22                            stx \1+(\2*2)
  23                            sty \1+(\2*2)+1
  24                            .endm
  25                   
  26                   storeget .macro ;store,index
  27                            ldx \1+(\2*2)
  28                            ldy \1+(\2*2)+1
  29                            .endm
  30                   
  31                   storewt  .macro ;store
  32                            ;A      -> index to write to
  33                            ;RegPtr -> pointer to store
  34                            sty hibyte+1
  35                            asl a ;x2
  36                            tay
  37                   
  38                            txa
  39                            sta \1,y
  40                   hibyte   lda #$ff
  41                            sta \1+1,y
  42                            .endm
  43                   
  44                   storerd  .macro ;store
  45                            ;A      -> index to read from
  46                            ;RegPtr <- pointer from store
  47                            asl a ;x2
  48                            tay
  49                   
  50                            lda \1,y
  51                            tax
  52                            lda \1+1,y
  53                            tay
  54                            .endm
  55                   
