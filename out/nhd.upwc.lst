   9                   
  10                   
  11                   
  12                   .include "main.asm"
   1                   
   2                   
   3                   jtable
   4                   ;---------------------------------------
   5                   
   6                   .block 
   7                   
   8 d500 4c c1 d5         jmp jlink       ; +$00 link             -> load driver
   9 d503 4c d1 d5         jmp junlink     ; +$03 unlink           -> unload driver 
  10 d506 4c d2 d5         jmp jsethand    ; +$06 sethand          -> config data handlers
  11 d509 4c e9 d5         jmp jpollget    ; +$09 pollget          -> check for data
  12 d50c 4c b2 d6         jmp jdataget    ; +$0c dataget          -> get byte rcv/cmd buff
  13 d50f 4c d8 d6         jmp jdataput    ; +$0f dataput          -> put byte snd buff 
  14 d512 4c ec d6         jmp jsetrate    ; +$12 setrate          -> set baud rate
  15 d515 4c 90 d6         jmp jssidstat   ; +$15 ssidstat         -> join ssid (wifi)
  16 d518 4c ee d6         jmp jopensock   ; +$18 opensock         -> open tcp socket
  17 d51b 4c 29 d5         jmp jnone       ; +$1b nhdpause         -> pause nmi 
  18 d51e 4c 29 d5         jmp jnone       ; +$1e hndresume        -> resume mni 
  19                   
  20                   .bend
  21                   
  22                   
  23                   jsig
  24                   ;---------------------------------------
  25 d521 57 49 43 36  .text "wic64drv"
     d525 34 44 52 56 
  26                   
  27                   
  28                   jnone
  29                   ;---------------------------------------
  30                   
  31                   .block
  32                   
  33                   .ifdef debug
  34 d529 a9 0b        lda #11
  35 d52b 8d 20 d0     sta $d020
  36 d52e 20 ab d5     jsr delay
  37                   .endif
  38                   
  39 d531 60               rts
  40                   
  41                   .bend 
  42                   
  43                   
  44                   push_cmd_buff
  45                   ;---------------------------------------
  46                   ;
  47                   ;   A -> byte to put in cmd buffer
  48                   ;   C -> set when buffer is past $ff
  49                   
  50                   .block 
  51                   
  52 d532 ee 7e db         inc d_cmd_buff_sz
  53 d535 ae 7e db         ldx d_cmd_buff_sz
  54 d538 9d 8e db         sta d_cmd_buff, x
  55                   
  56 d53b 60               rts 
  57                   
  58                   .bend 
  59                   
  60                   pop_cmd_buff
  61                   ;---------------------------------------
  62                   ;
  63                   ;   A <- byte from the cmd buffer
  64                   ;   C <- set when stack is now zero
  65                   
  66                   .block 
  67                   
  68 d53c 18               clc
  69 d53d ee 6e db         inc d_cmd_buff_pos
  70 d540 ae 6e db         ldx d_cmd_buff_pos
  71 d543 bd 8e db         lda d_cmd_buff, x
  72                       
  73                       ; have we reached the end?
  74                   
  75 d546 ec 7e db         cpx d_cmd_buff_sz 
  76 d549 d0 0f            bne return 
  77                   
  78                       ; reset buffer counters
  79                   
  80 d54b 8d 5b d5         sta tempa
  81                   
  82 d54e a9 00            lda #0
  83 d550 8d 6e db         sta d_cmd_buff_pos
  84 d553 8d 7e db         sta d_cmd_buff_sz
  85 d556 38               sec
  86                   
  87 d557 ad 5b d5         lda tempa
  88                   
  89                   return
  90                   
  91 d55a 60               rts 
  92                   
  93                   tempa 
  94                   
  95 d55b 00               .byte 0
  96                   
  97                   .bend 
  98                   
  99                   
 100                   push_rcv_buff
 101                   ;---------------------------------------
 102                   ;
 103                   ;   A -> byte to put in rcv buffer
 104                   
 105                   .block 
 106                   
 107 d55c ee 5e da         inc d_rcv_buff_sz
 108 d55f ae 5e da         ldx d_rcv_buff_sz
 109 d562 9d 6e da         sta d_rcv_buff, x
 110                   
 111 d565 60               rts 
 112                   
 113                   .bend 
 114                   
 115                   
 116                   pop_rcv_buff
 117                   ;---------------------------------------
 118                   ;
 119                   ;   A <- byte from the cmd buffer
 120                   ;   C <- set when stack is now zero
 121                   
 122                   .block 
 123                   
 124 d566 18               clc
 125 d567 ee 4e da         inc d_rcv_buff_pos
 126 d56a ae 4e da         ldx d_rcv_buff_pos
 127 d56d bd 6e da         lda d_rcv_buff, x
 128                       
 129                       ; have we reached the end?
 130                   
 131 d570 ec 5e da         cpx d_rcv_buff_sz 
 132 d573 d0 0f            bne return 
 133                   
 134                       ; reset buffer counters
 135                   
 136 d575 8d 85 d5         sta tempa
 137                   
 138 d578 a9 00            lda #0
 139 d57a 8d 4e da         sta d_rcv_buff_pos
 140 d57d 8d 5e da         sta d_rcv_buff_sz
 141 d580 38               sec
 142                   
 143 d581 ad 85 d5         lda tempa
 144                   
 145                   return
 146                   
 147 d584 60               rts 
 148                   
 149                   tempa 
 150                   
 151 d585 00               .byte 0
 152                   
 153                   .bend 
 154                   
 155                   push_snd_buff
 156                   ;---------------------------------------
 157                   ;
 158                   ;   A -> byte to put in snd buffer
 159                   
 160                   .block 
 161                   
 162 d586 ee fe d9         inc d_snd_buff_sz
 163 d589 ae fe d9         ldx d_snd_buff_sz
 164 d58c 9d 0e da         sta d_snd_buff, x
 165                   
 166 d58f 60               rts 
 167                   
 168                   .bend 
 169                   
 170                   
 171                   flush_snd_buff
 172                   ;---------------------------------------
 173                   ;
 174                   ;   A -> byte to put in snd buffer
 175                   
 176                   .block
 177                   
