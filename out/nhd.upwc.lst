  87                   
  88 d794 48                   pha 
  89                   
  90 d795 20 5a d7             jsr wic64_do_send_mode
  91                   
  92                           ; send 4 byte command to get the ip address
  93                   
  94 d798 a9 52                lda #"r"                ; protocol
  95 d79a 20 89 d7             jsr wic64_write_byte
  96 d79d 68                   pla                     ; command
  97 d79e 20 89 d7             jsr wic64_write_byte
  98 d7a1 a9 00                lda #$00                ; payload low
  99 d7a3 20 89 d7             jsr wic64_write_byte
 100 d7a6 a9 00                lda #$00                ; payload high
 101 d7a8 20 89 d7             jsr wic64_write_byte
 102                   
 103 d7ab 60                   rts
