  33                   
  34                   ;--------------------------------------
  35                   ; send command
  36                   ;
  37                   ; use this macro when you need to send a command with
  38                   ; no payload, for example the GET_VERSION_STRING
  39                   ; command requires no additional parameters
  40                   ;
  41                   ; paramaters:
  42                   ;
  43                   ;   1   wic64 command 
  44                   
  45                   w_snd_cmd .macro
  46                   
  47                       lda #\1
  48                       jsr wic64_do_send_command
  49                   
  50                   .endm
  51                   
  52                   ;--------------------------------------
  53                   ; send command with payload 
  54                   ;
  55                   ; use this macro when you do need to send a command with
  56                   ; no payload, for example the ECHO command 
  57                   ; requires a string, in addition the macro 
  58                   ; will determine the size of the payload before
  59                   ; sending and add that to the command
  60                   ;
  61                   ; parameters:
  62                   ;
  63                   ;   1   wic64 command
  64                   ;   2   pointer to payload 
  65                   ; 
  66                   
  67                   w_snd_cmd_pay .macro
  68                   
  69                       lda #\1
  70                       ldx #<\2
  71                       ldy #>\2
  72                       jsr wic64_do_send_command_with_payload
  73                   
  74                   .endm
  75                   
  76                   
  77                   ;--------------------------------------
  78                   ; recv data from wic64
  79                   ;
  80                   ; use this macro to read data coming back from the
  81                   ; wic64 and store it in payload
  82                   ;
  83                   ; paramaters:
  84                   ;
  85                   ;   1   pointer to data  
  86                   
  87                   w_rcv_dat .macro
  88                   
  89                       ldx #<wic64_payload
  90                       ldy #>wic64_payload
  91                       
  92                       jsr wic64_do_recv_data
  93                   
  94                   .endm
  95                   
  96                   
  97                   ;--------------------------------------
  98                   ; recv data from wic64 to memory
  99                   ;
 100                   ; use this macro to read data coming back from the
 101                   ; wic64 and store it in memory
 102                   ;
 103                   ; paramaters:
 104                   ;
 105                   ;   1   pointer to data  
 106                   
 107                   w_recv_datmem .macro
 108                   
 109                       ldx #<\1
 110                       ldy #>\1
 111                       
 112                       jsr wic64_do_recv_data
 113                   
 114                   .endm
