  71                   ;---------------------------------------
  72                   ;Flag Manipulation
  73                   
  74                   setflag  .macro ;ptr,index,flags
  75                            ldy #\2
  76                            lda (\1),y
  77                            ora #\3
  78                            sta (\1),y
  79                            .endm
  80                   
  81                   clrflag  .macro ;ptr,index,flags
  82                            ldy #\2
  83                            lda (\1),y
  84                            and #\3:$ff
  85                            sta (\1),y
  86                            .endm
  87                   
  88                   togflag  .macro ;ptr,index,flags
  89                            ldy #\2
  90                            lda (\1),y
  91                            eor #\3
  92                            sta (\1),y
  93                            .endm
  94                   
  95                   ;---------------------------------------
  96                   ;Setters and Getters
  97                   
  98                   setobj8  .macro ;ptr,offset,int8
  99                            ldy #\2
 100                            lda #\3
 101                            sta (\1),y
 102                            .endm
 103                   
 104                   setobj16 .macro ;ptr,offset,int16
 105                            ldy #\2
 106                            lda #<\3
 107                            sta (\1),y
 108                            iny
 109                            lda #>\3
 110                            sta (\1),y
 111                            .endm
 112                   
 113                   setobjptr .macro ;ptr,offset,ptr
 114                            ldy #\2
 115                            lda \3
 116                            sta (\1),y
 117                            iny
 118                            lda \3+1
 119                            sta (\1),y
 120                            .endm
 121                   
 122                   setobjxy .macro ;ptr,offset,(RegWrd)
 123                            tya
 124                            ldy #\2+1
 125                            sta (\1),y
 126                            dey
 127                            txa
 128                            sta (\1),y
 129                            .endm
 130                   
 131                   rdobj16  .macro ;ptr,offset
 132                            ;RegPtr <- property
 133                            ldy #\2
 134                            lda (\1),y
 135                            tax
 136                            iny
 137                            lda (\1),y
 138                            tay
 139                            .endm
 140                   
 141                   getobj16 .macro ;ptr,offset,to
 142                            ;A <- property hi byte
 143                            ldy #\2+1  ;offset hi byte
 144                            lda (\1),y
 145                            pha
 146                            dey        ;offset lo byte
 147                            lda (\1),y
 148                            sta \3     ;Save lo byte
 149                            pla
 150                            sta \3+1   ;Save hi byte
 151                            .endm
 152                   
 153                   ;---------------------------------------
 154                   
 155                   pushxy   .macro
 156                            tya ;Hi
 157                            pha
 158                            txa ;Lo
 159                            pha
 160                            .endm
 161                   
 162                   pullxy   .macro
 163                            pla
 164                            tax ;Lo
 165                            pla
 166                            tay ;Hi
 167                            .endm
 168                   
 169                   push16   .macro ;word to put on stack
 170                            lda #>\1 ;Hi
 171                            pha
 172                            lda #<\1 ;Lo
 173                            pha
 174                            .endm
 175                   
 176                   pushptr  .macro ;ptr to put on stack
 177                            lda \1+1 ;Hi
 178                            pha
 179                            lda \1   ;Lo
 180                            pha
 181                            .endm
 182                   
 183                   pull16   .macro ;ptr to pull from stack
 184                            pla
 185                            sta \1   ;Lo
 186                            pla
 187                            sta \1+1 ;Hi
 188                            .endm
 189                   
 190                   ;---------------------------------------
 191                   
 192                   copy16   .macro ;word,dest
 193                            lda #<\1
 194                            sta \2   ;1st: lo byte
 195                            lda #>\1
 196                            sta \2+1 ;2nd: hi byte
 197                            .endm
 198                   
 199                   copyptr  .macro ;ptr,dest
 200                            lda \1
 201                            sta \2   ;1st: lo byte
 202                            lda \1+1
 203                            sta \2+1 ;2nd: hi byte
 204                            .endm
