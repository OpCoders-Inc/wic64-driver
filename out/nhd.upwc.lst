  12                   .include "main.asm"
   1                   
   2                   
   3                   jtable
   4                   ;---------------------------------------
   5                   
   6                   .block 
   7                   
   8 1000 4c c1 10         jmp jlink       ; +$00 link             -> load driver
   9 1003 4c d1 10         jmp junlink     ; +$03 unlink           -> unload driver 
  10 1006 4c d2 10         jmp jsethand    ; +$06 sethand          -> config data handlers
  11 1009 4c e9 10         jmp jpollget    ; +$09 pollget          -> check for data
  12 100c 4c 87 11         jmp jdataget    ; +$0c dataget          -> get byte rcv/cmd buff
  13 100f 4c b3 11         jmp jdataput    ; +$0f dataput          -> put byte snd buff 
  14 1012 4c c7 11         jmp jsetrate    ; +$12 setrate          -> set baud rate
  15 1015 4c 65 11         jmp jssidstat   ; +$15 ssidstat         -> join ssid (wifi)
  16 1018 4c c9 11         jmp jopensock   ; +$18 opensock         -> open tcp socket
  17 101b 4c 29 10         jmp jnone       ; +$1b nhdpause         -> pause nmi 
  18 101e 4c 29 10         jmp jnone       ; +$1e hndresume        -> resume mni 
  19                   
  20                   .bend
  21                   
  22                   
  23                   jsig
  24                   ;---------------------------------------
  25 1021 57 49 43 36  .text "wic64drv"
     1025 34 44 52 56 
  26                   
  27                   
  28                   jnone
  29                   ;---------------------------------------
  30                   
  31                   .block
  32                   
  33                   .ifdef debug
  34 1029 a9 0b        lda #11
  35 102b 8d 20 d0     sta $d020
  36 102e 20 ab 10     jsr delay
  37                   .endif
  38                   
  39 1031 60               rts
  40                   
  41                   .bend 
  42                   
  43                   
  44                   push_cmd_buff
  45                   ;---------------------------------------
  46                   ;
  47                   ;   A -> byte to put in cmd buffer
  48                   ;   C -> set when buffer is past $ff
  49                   
  50                   .block 
  51                   
  52 1032 ee 83 15         inc d_cmd_buff_sz
  53 1035 ae 83 15         ldx d_cmd_buff_sz
  54 1038 9d 93 15         sta d_cmd_buff, x
  55                   
  56 103b 60               rts 
  57                   
  58                   .bend 
  59                   
  60                   pop_cmd_buff
  61                   ;---------------------------------------
  62                   ;
  63                   ;   A <- byte from the cmd buffer
  64                   ;   C <- set when stack is now zero
  65                   
  66                   .block 
  67                   
  68 103c 18               clc
  69 103d ee 73 15         inc d_cmd_buff_pos
  70 1040 ae 73 15         ldx d_cmd_buff_pos
  71 1043 bd 93 15         lda d_cmd_buff, x
  72                       
  73                       ; have we reached the end?
  74                   
  75 1046 ec 83 15         cpx d_cmd_buff_sz 
  76 1049 d0 0f            bne return 
  77                   
  78                       ; reset buffer counters
  79                   
  80 104b 8d 5b 10         sta tempa
  81                   
  82 104e a9 00            lda #0
  83 1050 8d 73 15         sta d_cmd_buff_pos
  84 1053 8d 83 15         sta d_cmd_buff_sz
  85 1056 38               sec
  86                   
  87 1057 ad 5b 10         lda tempa
  88                   
  89                   return
  90                   
  91 105a 60               rts 
  92                   
  93                   tempa 
  94                   
  95 105b 00               .byte 0
  96                   
  97                   .bend 
  98                   
  99                   
 100                   push_rcv_buff
 101                   ;---------------------------------------
 102                   ;
 103                   ;   A -> byte to put in rcv buffer
 104                   
 105                   .block 
 106                   
 107 105c ee 23 15         inc d_rcv_buff_sz
 108 105f ae 23 15         ldx d_rcv_buff_sz
 109 1062 9d 33 15         sta d_rcv_buff, x
 110                   
 111 1065 60               rts 
 112                   
 113                   .bend 
 114                   
 115                   
 116                   pop_rcv_buff
 117                   ;---------------------------------------
 118                   ;
 119                   ;   A <- byte from the cmd buffer
 120                   ;   C <- set when stack is now zero
 121                   
 122                   .block 
 123                   
 124 1066 18               clc
 125 1067 ee 13 15         inc d_rcv_buff_pos
 126 106a ae 13 15         ldx d_rcv_buff_pos
 127 106d bd 33 15         lda d_rcv_buff, x
 128                       
 129                       ; have we reached the end?
 130                   
 131 1070 ec 23 15         cpx d_rcv_buff_sz 
 132 1073 d0 0f            bne return 
 133                   
 134                       ; reset buffer counters
 135                   
 136 1075 8d 85 10         sta tempa
 137                   
 138 1078 a9 00            lda #0
 139 107a 8d 13 15         sta d_rcv_buff_pos
 140 107d 8d 23 15         sta d_rcv_buff_sz
 141 1080 38               sec
 142                   
 143 1081 ad 85 10         lda tempa
 144                   
 145                   return
 146                   
 147 1084 60               rts 
 148                   
 149                   tempa 
 150                   
 151 1085 00               .byte 0
 152                   
 153                   .bend 
 154                   
 155                   push_snd_buff
 156                   ;---------------------------------------
 157                   ;
 158                   ;   A -> byte to put in snd buffer
 159                   
 160                   .block 
 161                   
 162 1086 ee c3 14         inc d_snd_buff_sz
 163 1089 ae c3 14         ldx d_snd_buff_sz
 164 108c 9d d3 14         sta d_snd_buff, x
 165                   
 166 108f 60               rts 
 167                   
 168                   .bend 
 169                   
 170                   
 171                   flush_snd_buff
 172                   ;---------------------------------------
 173                   ;
 174                   ;   A -> byte to put in snd buffer
 175                   
 176                   .block
 177                   
 178                       ; add zero byte to end 
 179                   
 180 1090 a9 00            lda #0
 181 1092 20 86 10         jsr push_snd_buff 
 182                   
 183                       ; reset buffer pointers
