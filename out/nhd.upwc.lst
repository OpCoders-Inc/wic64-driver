 132 1291 85 fa                sta $fa 
 133 1293 98                   tya
 134 1294 85 fb                sta $fb
 135                   
 136 1296 a0 00                ldy #$00
 137                   
 138                       loop1
 139                   
 140 1298 b1 fa                lda ($fa),y
 141 129a f0 0b                beq send
