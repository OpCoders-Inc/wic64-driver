 137                   
 138                   ; send wic64 command with payload
 139                   ; ---------------------------------------------------------
 140                   ;
 141                   ;   Sends a command with a Payload to the Wic64.
 142                   ;
 143                   ;   Parameters:
 144                   ;
 145                   ;       .A  wic64 command 
 146                   ;       .X  pointer to payload low byte 
 147                   ;       .Y  pointer to payload high byte 
 148                   
 149                       wic64_do_send_command_with_payload
 150                   
 151                           .block 
 152                   
 153 d7c2 48                   pha
 154                   
 155                           ; get payload size 
 156                   
 157 d7c3 a9 00                lda #$00
 158 d7c5 8d 2e d9             sta wic64_payload_size
 159 d7c8 8d 2f d9             sta wic64_payload_size + 1
 160                   
 161 d7cb 8a                   txa
 162 d7cc 85 fa                sta $fa 
 163 d7ce 98                   tya
 164 d7cf 85 fb                sta $fb
 165                   
 166 d7d1 a0 00                ldy #$00
 167                   
 168                       loop1
 169                   
 170 d7d3 b1 fa                lda ($fa),y
 171 d7d5 f0 0b                beq send
 172                   
 173 d7d7 ee 2e d9             inc wic64_payload_size
 174 d7da d0 03                bne next
 175 d7dc ee 2f d9             inc wic64_payload_size + 1
 176                   
 177                       next
 178                   
 179 d7df c8                   iny
 180                   
 181 d7e0 d0 f1                bne loop1
 182                   
 183                       send
 184                           
 185 d7e2 20 5a d7             jsr wic64_do_send_mode
 186                   
 187                           ; send command to wic64 with payload 
 188                   
 189 d7e5 a9 52                lda #"r"                        ; protocol
 190 d7e7 20 89 d7             jsr wic64_write_byte
 191 d7ea 68                   pla                             ; command
 192 d7eb 20 89 d7             jsr wic64_write_byte
 193 d7ee ad 2e d9             lda wic64_payload_size          ; payload low
 194 d7f1 20 89 d7             jsr wic64_write_byte
 195 d7f4 ad 2f d9             lda wic64_payload_size + 1      ; payload high
 196 d7f7 20 89 d7             jsr wic64_write_byte
 197                   
 198 d7fa a0 00                ldy #$00
 199                   
 200                       loop2
 201                   
 202 d7fc b1 fa                lda ($fa),y
 203 d7fe f0 06                beq done 
 204 d800 20 89 d7             jsr wic64_write_byte
 205 d803 c8                   iny 
 206 d804 d0 f6                bne loop2
 207                   
 208                       done
 209                   
 210 d806 60                   rts
 211                   
 212                           .bend
